      "code": "def calculator(expr):\n    expr = expr.replace(' ', '')\n    tokens = []\n    i = 0\n    while i < len(expr):\n        if expr[i].isdigit():\n            j = i\n            while j < len(expr) and expr[j].isdigit():\n                j += 1\n            tokens.append(int(expr[i:j]))\n            i = j\n        else:\n            tokens.append(expr[i])\n            i += 1\n\n    i = 0\n    while i < len(tokens):\n        if tokens[i] == '*':\n            left = tokens[i - 1]\n            right = tokens[i + 1]\n            tokens[i - 1:i + 2] = [left * right]\n            i -= 1\n        else:\n            i += 1\n\n    result = tokens[0]\n    i = 1\n    while i < len(tokens):\n        if tokens[i] == '+':\n            result += tokens[i + 1]\n        elif tokens[i] == '-':\n            result -= tokens[i + 1]\n        i += 2\n\n    return result",
