      "code": "def calculator(expr):\n    tokens = []\n    num = 0\n    in_num = False\n    for ch in expr:\n        if ch.isdigit():\n            num = num * 10 + int(ch)\n            in_num = True\n        else:\n            if in_num:\n                tokens.append(num)\n                num = 0\n                in_num = False\n            if ch in '+-*':\n                tokens.append(ch)\n    if in_num:\n        tokens.append(num)\n\n    stack = []\n    i = 0\n    while i < len(tokens):\n        tok = tokens[i]\n        if tok == '*':\n            left = stack.pop()\n            right = tokens[i + 1]\n            stack.append(left * right)\n            i += 2\n        else:\n            stack.append(tok)\n            i += 1\n\n    result = stack[0]\n    i = 1\n    while i < len(stack):\n        op = stack[i]\n        operand = stack[i + 1]\n        if op == '+':\n            result += operand\n        else:\n            result -= operand\n        i += 2\n    return result",
