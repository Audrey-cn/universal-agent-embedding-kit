      "code": "def two_sum(nums, target):\n    seen = {}\n    for i, x in enumerate(nums):\n        j = seen.get(target - x)\n        if j is not None and j != i:\n            return [min(j, i), max(j, i)]\n        seen[x] = i\n    return []",
