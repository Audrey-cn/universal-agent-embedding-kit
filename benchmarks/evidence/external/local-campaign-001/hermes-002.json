      "code": "def longest_unique_substring(s):\n    seen = {}\n    left = 0\n    best = 0\n    for right, ch in enumerate(s):\n        if ch in seen and seen[ch] >= left:\n            left = seen[ch] + 1\n        seen[ch] = right\n        current = right - left + 1\n        if current > best:\n            best = current\n    return best",
