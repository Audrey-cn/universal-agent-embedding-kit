      "code": "def calculator(expr):\n    tokens = []\n    num = 0\n    for ch in expr:\n        if ch.isdigit():\n            num = num * 10 + int(ch)\n        elif ch in '+-*':\n            tokens.append(num)\n            tokens.append(ch)\n            num = 0\n    tokens.append(num)\n    values = [tokens[0]]\n    ops = []\n    i = 1\n    while i < len(tokens):\n        op, operand = tokens[i], tokens[i + 1]\n        if op == '*':\n            values[-1] *= operand\n        else:\n            ops.append(op)\n            values.append(operand)\n        i += 2\n    result = values[0]\n    for op, val in zip(ops, values[1:]):\n        result = result + val if op == '+' else result - val\n    return result",
