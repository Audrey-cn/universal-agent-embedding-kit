      "code": "def calculator(expr):\n    tokens = []\n    num = 0\n    for ch in expr:\n        if ch.isdigit():\n            num = num * 10 + int(ch)\n        elif ch in '+-*':\n            tokens.append(num)\n            tokens.append(ch)\n            num = 0\n    tokens.append(num)\n    stack = []\n    i = 0\n    while i < len(tokens):\n        if tokens[i] == '*':\n            left = stack.pop()\n            stack.append(left * tokens[i + 1])\n            i += 2\n        else:\n            stack.append(tokens[i])\n            i += 1\n    result = stack[0]\n    i = 1\n    while i < len(stack):\n        if stack[i] == '+':\n            result += stack[i + 1]\n        else:\n            result -= stack[i + 1]\n        i += 2\n    return result",
