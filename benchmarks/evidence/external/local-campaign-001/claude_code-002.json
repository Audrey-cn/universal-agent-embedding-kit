      "code": "def calculator(expr):\n    s = ''.join(expr.split())\n    i = 0\n    n = len(s)\n\n    def read_number():\n        nonlocal i\n        start = i\n        while i < n and s[i].isdigit():\n            i += 1\n        return int(s[start:i])\n\n    total = 0\n    sign = 1\n    term = read_number()\n\n    while i < n:\n        op = s[i]\n        i += 1\n        value = read_number()\n        if op == '*':\n            term *= value\n        else:\n            total += sign * term\n            term = value\n            sign = 1 if op == '+' else -1\n\n    return total + sign * term",
