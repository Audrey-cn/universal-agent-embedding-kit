      "code": "def longest_unique_substring(s):\n    last_seen = {}\n    start = 0\n    max_len = 0\n    for end, char in enumerate(s):\n        if char in last_seen and last_seen[char] >= start:\n            start = last_seen[char] + 1\n        last_seen[char] = end\n        max_len = max(max_len, end - start + 1)\n    return max_len",
