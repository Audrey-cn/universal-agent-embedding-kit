      "code": "def two_sum(nums, target):\n    seen = {}\n    for j, num in enumerate(nums):\n        complement = target - num\n        if complement in seen:\n            i = seen[complement]\n            if i < j:\n                return [i, j]\n            return [j, i]\n        if num not in seen:\n            seen[num] = j\n    raise ValueError(\"No two sum solution\")",
