      "code": "def longest_unique_substring(s):\n    char_index = {}\n    start = 0\n    longest = 0\n    for end, char in enumerate(s):\n        if char in char_index and char_index[char] >= start:\n            start = char_index[char] + 1\n        char_index[char] = end\n        longest = max(longest, end - start + 1)\n    return longest",
