      "code": "def calculator(expr):\n    expr = expr.replace(\" \", \"\")\n    nums = []\n    ops = []\n    i, n = 0, len(expr)\n    while i < n:\n        if expr[i].isdigit():\n            j = i\n            while j < n and expr[j].isdigit():\n                j += 1\n            nums.append(int(expr[i:j]))\n            i = j\n        else:\n            ops.append(expr[i])\n            i += 1\n    while '*' in ops:\n        idx = ops.index('*')\n        nums[idx] = nums[idx] * nums[idx + 1]\n        del nums[idx + 1]\n        del ops[idx]\n    result = nums[0]\n    for op, num in zip(ops, nums[1:]):\n        if op == '+':\n            result += num\n        else:\n            result -= num\n    return result",
