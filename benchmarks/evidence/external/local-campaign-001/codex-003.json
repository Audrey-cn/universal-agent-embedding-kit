      "code": "def roman_to_int(s):\n    values = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n    total = 0\n    prev = 0\n    for ch in reversed(s):\n        cur = values[ch]\n        if cur < prev:\n            total -= cur\n        else:\n            total += cur\n        prev = cur\n    return total",
