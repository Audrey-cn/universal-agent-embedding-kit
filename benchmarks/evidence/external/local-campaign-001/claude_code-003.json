      "code": "def two_sum(nums, target):\n    seen = {}\n    for j, num in enumerate(nums):\n        i = seen.get(target - num)\n        if i is not None and i != j:\n            return [min(i, j), max(i, j)]\n        seen.setdefault(num, j)\n    return None",
