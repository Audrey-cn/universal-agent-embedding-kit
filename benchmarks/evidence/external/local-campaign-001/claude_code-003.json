      "code": "def calculator(expr):\n    nums = []\n    ops = []\n    i = 0\n    n = len(expr)\n    while i < n:\n        if expr[i].isspace():\n            i += 1\n        elif expr[i].isdigit():\n            j = i\n            while j < n and expr[j].isdigit():\n                j += 1\n            nums.append(int(expr[i:j]))\n            i = j\n        else:\n            ops.append(expr[i])\n            i += 1\n    terms = [nums[0]]\n    term_ops = []\n    for k, op in enumerate(ops):\n        if op == '*':\n            terms[-1] *= nums[k + 1]\n        else:\n            terms.append(nums[k + 1])\n            term_ops.append(op)\n    result = terms[0]\n    for op, val in zip(term_ops, terms[1:]):\n        if op == '+':\n            result += val\n        else:\n            result -= val\n    return result",
