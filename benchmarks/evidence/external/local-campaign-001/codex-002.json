      "code": "def calculator(expr):\n    tokens = []\n    i = 0\n    while i < len(expr):\n        c = expr[i]\n        if c == ' ':\n            i += 1\n            continue\n        if c in '+-*':\n            tokens.append(c)\n            i += 1\n        else:\n            j = i\n            while j < len(expr) and expr[j].isdigit():\n                j += 1\n            tokens.append(int(expr[i:j]))\n            i = j\n\n    # First pass: handle all * operations\n    i = 0\n    while i < len(tokens):\n        if tokens[i] == '*':\n            left = tokens[i - 1]\n            right = tokens[i + 1]\n            tokens[i - 1:i + 2] = [left * right]\n            i -= 1\n        i += 1\n\n    # Second pass: handle + and - left-to-right\n    result = tokens[0]\n    i = 1\n    while i < len(tokens):\n        op = tokens[i]\n        num = tokens[i + 1]\n        if op == '+':\n            result += num\n        else:\n            result -= num\n        i += 2\n\n    return result",
