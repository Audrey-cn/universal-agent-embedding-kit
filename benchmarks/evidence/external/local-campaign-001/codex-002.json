      "code": "def roman_to_int(s):\n    values = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}\n    total = 0\n    prev = 0\n    for c in reversed(s):\n        curr = values[c]\n        if curr < prev:\n            total -= curr\n        else:\n            total += curr\n        prev = curr\n    return total",
