      "code": "def calculator(expr):\n    tokens = []\n    i = 0\n    n = len(expr)\n    while i < n:\n        c = expr[i]\n        if c.isspace():\n            i += 1\n        elif c.isdigit():\n            j = i\n            while j < n and expr[j].isdigit():\n                j += 1\n            tokens.append(int(expr[i:j]))\n            i = j\n        else:\n            tokens.append(c)\n            i += 1\n    reduced = [tokens[0]]\n    k = 1\n    while k < len(tokens):\n        op, val = tokens[k], tokens[k + 1]\n        if op == '*':\n            reduced[-1] *= val\n        else:\n            reduced.append(op)\n            reduced.append(val)\n        k += 2\n    result = reduced[0]\n    k = 1\n    while k < len(reduced):\n        if reduced[k] == '+':\n            result += reduced[k + 1]\n        else:\n            result -= reduced[k + 1]\n        k += 2\n    return result",
