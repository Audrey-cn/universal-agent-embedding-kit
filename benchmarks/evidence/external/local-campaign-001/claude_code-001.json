      "code": "def two_sum(nums, target):\n    seen = {}\n    for j, num in enumerate(nums):\n        complement = target - num\n        if complement in seen:\n            i = seen[complement]\n            return [i, j] if i < j else [j, i]\n        seen[num] = j\n    return None",
