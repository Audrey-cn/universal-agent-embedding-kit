      "code": "def roman_to_int(s):\n    values = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}\n    total = 0\n    prev = 0\n    for ch in reversed(s):\n        value = values[ch]\n        if value < prev:\n            total -= value\n        else:\n            total += value\n        prev = value\n    return total",
