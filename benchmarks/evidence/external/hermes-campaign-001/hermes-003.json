      "code": "def calculator(expr):\n    tokens = []\n    num = 0\n    for ch in expr:\n        if ch.isdigit():\n            num = num * 10 + int(ch)\n        elif ch in \"+-*\":\n            tokens.append(num)\n            tokens.append(ch)\n            num = 0\n    tokens.append(num)\n\n    stack = [tokens[0]]\n    i = 1\n    while i < len(tokens):\n        op = tokens[i]\n        operand = tokens[i + 1]\n        if op == \"*\":\n            stack.append(stack.pop() * operand)\n        else:\n            stack.append(op)\n            stack.append(operand)\n        i += 2\n\n    result = stack[0]\n    i = 1\n    while i < len(stack):\n        if stack[i] == \"+\":\n            result += stack[i + 1]\n        else:\n            result -= stack[i + 1]\n        i += 2\n    return result",
