      "code": "def longest_unique_substring(s):\n    last_seen = {}\n    start = 0\n    longest = 0\n    for i, ch in enumerate(s):\n        if ch in last_seen and last_seen[ch] >= start:\n            start = last_seen[ch] + 1\n        last_seen[ch] = i\n        if i - start + 1 > longest:\n            longest = i - start + 1\n    return longest",
