      "code": "def lru_cache_sim(capacity, ops):\n    cache = {}\n    order = []\n    results = []\n    for op in ops:\n        if op[0] == 'put':\n            key, value = op[1], op[2]\n            if key in cache:\n                order.remove(key)\n            elif len(cache) >= capacity:\n                oldest = order.pop(0)\n                del cache[oldest]\n            cache[key] = value\n            order.append(key)\n        elif op[0] == 'get':\n            key = op[1]\n            if key in cache:\n                order.remove(key)\n                order.append(key)\n                results.append(cache[key])\n            else:\n                results.append(-1)\n    return results",
